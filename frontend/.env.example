# Copy to .env.local before `npm run dev`.

# Reader for the Check page. Only "gemini" is supported today.
LLM_PROVIDER=gemini

# Google AI Studio key for the Check page. Server-side only, never sent to the browser.
GEMINI_API_KEY=

# A model id marked as free in Google AI Studio (the SDK call names it directly).
GEMINI_MODEL=

# Engine base URL the browser calls for candles and backtests.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080

# Max Check-page extractions per IP per day. Positive integer; defaults to 20.
CHECK_DAILY_LIMIT=20
