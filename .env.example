# Replaylab engine environment. Copy to .env and export it before `cargo run`:
#   set -a; source .env; set +a
# The frontend has its own variables in frontend/.env.example.

# Interface the engine listens on. An IP address, not a hostname.
HOST=127.0.0.1

# TCP port the engine listens on.
PORT=8080

# Browser origins allowed by CORS, comma-separated.
ALLOWED_ORIGINS=http://localhost:3000

# Directory for the candle cache.
CACHE_DIR=.cache

# SQLite file for saved runs. Defaults to CACHE_DIR/runs.db.
DB_PATH=.cache/runs.db

# Binance API base URL. Leave unset unless you need a mirror.
BINANCE_BASE_URL=

# Requests per minute per IP for POST /backtest.
BACKTEST_RATE_PER_MIN=30

# Requests per minute per IP for POST /optimize.
OPTIMIZE_RATE_PER_MIN=5

# Optimizer jobs allowed to run at once.
MAX_OPTIMIZER_JOBS=2

# Seconds before POST /backtest gives up (5 to 600, default 60).
BACKTEST_TIMEOUT_SECS=60
